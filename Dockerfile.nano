# escape=`

# ====================================================================
# OMODA & JAECOO - Gestion de Parc IT
# Windows Nano Server 2025
#
# L'application est déjà compilée par Jenkins :
#   - dist/
#   - node_modules/
#
# Aucune installation npm ni recompilation dans le conteneur.
# ====================================================================

FROM mcr.microsoft.com/windows/nanoserver:ltsc2025

# --------------------------------------------------------------------
# Node.js
# --------------------------------------------------------------------

ARG NODE_VERSION=22.14.0

ENV NODE_VERSION=${NODE_VERSION}

# --------------------------------------------------------------------
# Télécharger et extraire Node.js
#
# Nano Server n'utilise pas PowerShell.
# On utilise curl + tar, disponibles dans Nano Server récent.
# --------------------------------------------------------------------

WORKDIR C:\

ADD https://nodejs.org/dist/v22.14.0/node-v22.14.0-win-x64.zip C:\node.zip

RUN mkdir C:\nodejs && `
    tar -xf C:\node.zip -C C:\nodejs --strip-components=1 && `
    del C:\node.zip

# --------------------------------------------------------------------
# PATH
# --------------------------------------------------------------------

ENV PATH="C:\nodejs;C:\Windows\System32;C:\Windows"

# --------------------------------------------------------------------
# Application
# --------------------------------------------------------------------

WORKDIR C:\app

COPY package.json ./
COPY dist ./dist
COPY Backend ./Backend
COPY public ./public
COPY index.html ./
COPY node_modules ./node_modules

# --------------------------------------------------------------------
# Production
# --------------------------------------------------------------------

ENV NODE_ENV=production `
    PORT=3000

EXPOSE 3000

# --------------------------------------------------------------------
# Démarrage
# --------------------------------------------------------------------

CMD ["C:\\nodejs\\node.exe", "C:\\app\\dist\\server.cjs"]
